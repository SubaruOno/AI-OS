{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./backend/.env)",
      "Read(./frontend/.env)",
      "Write(./.env)",
      "Write(./.env.local)",
      "Write(./.env.production)",
      "Write(./backend/.env)",
      "Write(./frontend/.env)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(supabase db reset:*)",
      "Bash(rm -rf:*)"
    ],
    "ask": [
      "Bash(pnpm add:*)",
      "Bash(pnpm remove:*)",
      "Bash(npm install:*)",
      "Bash(uv add:*)",
      "Bash(uv remove:*)",
      "Bash(supabase db push:*)",
      "Bash(supabase link:*)",
      "Bash(vercel deploy:*)",
      "Bash(vercel env:*)",
      "Bash(railway up:*)",
      "Bash(railway variables:*)",
      "Bash(git push:*)"
    ]
  }
}
