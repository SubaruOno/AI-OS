# Secrets. Never committed, never pushed.
.env
credentials/
tokens.json
*-oauth-token.json

# The owner-only drawer. Lives on this machine only.
private/

# The raw dump. Whatever gets thrown in here (client lists, financial summaries,
# chat exports, half-finished docs) stays on this machine. /install reads it and
# distils it into context/; the originals never reach the backup.
context/import/*
!context/import/.gitkeep

# Local state
.install-state
.DS_Store

# Obsidian's per-machine view settings. The notes are yours and are tracked;
# how your copy of Obsidian displays them is not.
.obsidian/
__pycache__/
*.pyc
.venv/
venv/
node_modules/

# 就活ボード: 企業名や選考状況を含む生成物は private と同じ扱いにする
apps/job-hunt-board/data/
apps/job-hunt-board/mobile/.expo/
apps/job-hunt-board/mobile/ios/
apps/job-hunt-board/mobile/android/
# ログインIDを含むので、アプリ同梱分もGitに載せない
apps/job-hunt-board/mobile/assets/mypages.json
# 企業名と選考状況を含むので、アプリ同梱のフィードもGitに載せない
apps/job-hunt-board/mobile/assets/feed.json

# Databases and generated local archives
*.db
*.db-shm
*.db-wal
outputs/**/*.zip
.firecrawl/

# Per-machine seat identity
.seat
outputs/walk-town/store-upload/
